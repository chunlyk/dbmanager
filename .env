# .env
DJANGO_SECRET_KEY=please-change-me
DJANGO_DEBUG=1

# 密码加密密钥（生产必须独立设置，建议长度 >= 50 位随机串）
PASSWORD_ENCRYPTION_KEY=please-change-me-too
PASSWORD_LENGTH=20

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# 是否把请求耗时落库（高并发下建议关闭）
REQUEST_TIMING_LOG_TO_DB=1